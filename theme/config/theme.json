{
  "name": "ModoShop Theme",
  "version": "3.3.0",
  "architecture": "shopify-inspired-static",
  "sourceOfTruth": [
    "theme/layout",
    "theme/sections",
    "theme/snippets",
    "theme/templates",
    "theme/assets",
    "theme/config",
    "theme/media"
  ],
  "performance": {
    "imageSourcePack": "theme/media/source-images.zip",
    "imageCompressor": "Sharp",
    "imageFormat": "WebP",
    "imageQuality": 82,
    "htmlCssJsMinify": true,
    "lazyLoad": true,
    "apiCacheSeconds": 30,
    "catalogCacheSeconds": 60
  },
  "routes": {
    "home": "/",
    "product": "/products/:id",
    "cart": "/cart",
    "tracking": "/track/:id",
    "admin": "/admin.html"
  }
}