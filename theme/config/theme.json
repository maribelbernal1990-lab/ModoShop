{
  "name": "ModoShop Theme",
  "version": "3.1.0",
  "routes": {
    "home": "/",
    "product": "/products/:id",
    "cart": "/cart",
    "tracking": "/track/:id"
  },
  "performance": {
    "imageCDN": true,
    "buildWebP": true,
    "htmlCssJsMinify": true,
    "lazyLoad": true,
    "apiCacheSeconds": 30,
    "catalogCacheSeconds": 60
  },
  "architecture": "shopify-inspired-static",
  "sourceOfTruth": [
    "theme/layout",
    "theme/sections",
    "theme/snippets",
    "theme/templates",
    "theme/assets",
    "theme/config"
  ]
}
